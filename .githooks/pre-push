#!/usr/bin/env bash
# Reforço no push: usuários fora da whitelist não fazem push para a master
# e só publicam branches com nome dentro do padrão.

source "$(git rev-parse --show-toplevel)/.githooks/lib.sh"

is_authorized && exit 0

while read -r local_ref local_oid remote_ref remote_oid; do
  case "$remote_ref" in
    refs/heads/master)
      deny "Push para a master é restrito a usuários autorizados.
  Abra um Pull Request da development para a master."
      ;;
    refs/heads/*)
      branch="${remote_ref#refs/heads/}"
      if [ "$branch" != "development" ] && ! [[ "$branch" =~ $BRANCH_REGEX ]]; then
        deny "Nome de branch fora do padrão: \"$branch\" (veja docs/padroes-git-branch-commit-pr.md)."
      fi
      ;;
  esac
done

exit 0
